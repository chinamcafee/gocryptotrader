> 本文件由 `scripts/dev-all.mjs` 读取（也可手动 export）。所有变量都有安全默认值，**不填也能跑**。

# 本地代理监听地址（前端 /api 会转发到这里）
GCT_PROXY_HOST=127.0.0.1
GCT_PROXY_PORT=8788

# GoCryptoTrader REST 网关（gRPC-gateway）。程序内会自动把 /v1/ 前缀补上。
GCT_GATEWAY_BASE=https://127.0.0.1:9053/v1/

# 配置文件路径：代理从这里读 remoteControl.username / password 注入 Basic Auth。
# 凭据**只在代理进程内存中**，绝不进入浏览器（安全红线：前端不得持有凭据）。
GCT_CONFIG_PATH=~/.gocryptotrader/config.json

# 是否放行写操作（下单/改杠杆/审批/清 halt 等）。
# 默认 false：所有写请求返回 501，前端展示"后端待实现/未授权"，避免误操作真实资金。
GCT_ALLOW_WRITES=false

# 上游请求超时（毫秒）
GCT_UPSTREAM_TIMEOUT_MS=45000

# 跳过上游 TLS 校验（REST 网关用自签证书，本地开发必须 true）
GCT_TLS_INSECURE=true
